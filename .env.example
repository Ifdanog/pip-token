# Copy to .env and fill in. NEVER commit .env or share your private key.

# Private key of the wallet that pays for deployment (needs a little AVAX).
# Use a fresh wallet just for deploying, not your main wallet.
DEPLOYER_PRIVATE_KEY=

# Receives the "treasury" buckets. Use a multisig (e.g. Safe on Avalanche).
TREASURY_ADDRESS=

# Receives team tokens as they vest.
TEAM_BENEFICIARY=

# Optional: custom RPC endpoints (defaults are the public Avalanche ones).
FUJI_RPC_URL=
AVALANCHE_RPC_URL=

# Optional: Snowtrace verification works without a real key.
SNOWTRACE_API_KEY=
