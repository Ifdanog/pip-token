{
  "name": "pip-token",
  "version": "1.0.0",
  "description": "Pip Token ($PIP): fixed-supply ERC-20 for Avalanche C-Chain",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:local": "hardhat run scripts/deploy.js",
    "deploy:fuji": "hardhat run scripts/deploy.js --network fuji",
    "deploy:mainnet": "CONFIRM_MAINNET=yes hardhat run scripts/deploy.js --network avalanche",
    "verify:fuji": "hardhat run scripts/verify.js --network fuji",
    "verify:mainnet": "hardhat run scripts/verify.js --network avalanche"
  },
  "license": "ISC",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^18.0.5",
    "hardhat": "^2.29.1",
    "solc": "^0.8.28"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  },
  "private": true
}
